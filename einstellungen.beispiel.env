# ===== Pflicht =====

# Euer Claude-API-Schlüssel von https://platform.claude.com (Bereich "API Keys")
ANTHROPIC_API_KEY=

# Eure Konten: name:passwort, durch Komma getrennt.
# Werden beim ersten Start angelegt. Passwörter danach in der App unter ⚙︎ ändern.
INITIAL_USERS=lena:bitte-aendern,max:bitte-aendern

# ===== Optional =====

# Name eurer KI (oben links und beim Login)
AI_NAME=Unsere KI

# Modell für neue Chats: claude-opus-5-5 (am klügsten), claude-sonnet-5-5, claude-haiku-5-5 (am günstigsten)
DEFAULT_MODEL=claude-opus-5-5

# Wie gründlich Claude nachdenkt: low (schnell, günstig), medium, high (gründlich, teurer)
CLAUDE_EFFORT=medium

# Port der Weboberfläche
# Port: in docker-compose.yml bei "ports" ändern (Standard 3000)

# Auf "true" setzen, wenn ihr die Seite über HTTPS aufruft
COOKIE_SECURE=false

# Nur für lokale Offline-Modelle (siehe README), sonst leer lassen
OLLAMA_URL=
